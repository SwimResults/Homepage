<IfModule mod_mime.c>
    AddType application/xml .xml
</IfModule>

RewriteEngine on

RewriteRule ^(api)($|/) - [L]

# Extract language from URL and pass it as query parameter
# /en/path -> index.php?path=path&lang=en
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/(.*)$ /index.php?path=$1&lang=en [NC,L,QSA]

# /de/path -> index.php?path=path&lang=de
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^de/(.*)$ /index.php?path=$1&lang=de [NC,L,QSA]

# Default path (no language prefix) -> don't force lang, let session decide
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/en/
RewriteCond %{REQUEST_URI} !^/de/
RewriteRule ^(.*)$ /index.php?path=$1 [NC,L,QSA]

Redirect 302 /iesc "https://app.swimresults.de/m/IESC25"
Redirect 302 /dm-fs-2024 "https://app.swimresults.de/m/DMFS24"
Redirect 302 /osfc "https://app.swimresults.de/m/OSFC25"
Redirect 302 /stolle "https://app.swimresults.de/m/CSSF25"
Redirect 302 /mdm "https://app.swimresults.de/m/MDM25"
Redirect 302 /goldenes-ei "https://app.swimresults.de/m/OMKGE26"
Redirect 302 /gothaer "https://app.swimresults.de/m/BGF26"
Redirect 302 /lms-sa "https://app.swimresults.de/m/LMSSA26"
Redirect 302 /silbererz "https://app.swimresults.de/m/SESM26"

Redirect 302 /app-test "https://testflight.apple.com/join/Pg4ZdcSS"
Redirect 302 /ios "https://apps.apple.com/de/app/swimresults/id6503343578"
Redirect 302 /android "https://play.google.com/store/apps/details?id=de.swimresults.swimresults"

Redirect 302 /interfaces "https://swimresults.github.io/Livestreaming/src/stream-ui/"
